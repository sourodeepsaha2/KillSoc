# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/killsoc?schema=public

# GitHub OAuth Integration
GITHUB_CLIENT_ID=your_github_client_id_placeholder
GITHUB_CLIENT_SECRET=your_github_client_secret_placeholder
GITHUB_CALLBACK_URL=http://localhost:5001/api/auth/github/callback

# JWT Authentication
JWT_SECRET=your_jwt_secret_placeholder_min_32_chars
JWT_EXPIRES_IN=7d

# Token Encryption (AES-256-GCM)
TOKEN_ENCRYPTION_KEY=your_token_encryption_key_placeholder_min_32_chars

# Background Jobs & Caching (Redis + BullMQ)
REDIS_URL=redis://localhost:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
BULLMQ_CONCURRENCY=5
BULLMQ_MAX_RETRIES=3
BULLMQ_BACKOFF_DELAY_MS=2000

# AI Service & Recommendation Engine
AI_PROVIDER=gemini # 'gemini' | 'openai' | 'mock'
AI_MODEL=gemini-1.5-flash
AI_API_KEY=your_gemini_or_llm_api_key_placeholder
AI_MAX_TOKENS=2048
AI_TIMEOUT_MS=15000
AI_CACHE_TTL_HOURS=24
LLM_API_KEY=your_llm_api_key_placeholder
