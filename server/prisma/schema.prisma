generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String            @id @default(uuid()) @db.Uuid
  githubId             String            @unique
  githubUsername       String            @unique
  email                String?
  avatarUrl            String?
  encryptedAccessToken String?
  tokenIv              String?
  tokenTag             String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  skills          DeveloperSkill[]
  recommendations Recommendation[]

  @@map("users")
}

model Organization {
  id          String             @id @default(uuid()) @db.Uuid
  name        String
  slug        String             @unique
  description String?
  website     String?
  githubUrl   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  years           OrganizationYear[]
  repositories    Repository[]
  recommendations Recommendation[]

  @@map("organizations")
}

model OrganizationYear {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  year           Int
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, year])
  @@index([organizationId])
  @@index([year])
  @@map("organization_years")
}

model Repository {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  githubRepoId   String        @unique
  name           String
  fullName       String        @unique
  description    String?
  language       String?
  stars           Int                 @default(0)
  forks           Int                 @default(0)
  openIssues      Int                 @default(0)
  topics          String[]            @default([])
  extractedSkills String[]            @default([])
  lastUpdatedAt   DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization    Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  issues          Issue[]
  analysis        RepositoryAnalysis?
  recommendations Recommendation[]

  @@index([organizationId])
  @@index([language])
  @@index([stars])
  @@map("repositories")
}

model RepositoryAnalysis {
  id                 String     @id @default(uuid()) @db.Uuid
  repositoryId       String     @unique @db.Uuid
  overallScore       Float
  activityScore      Float
  communityScore     Float
  documentationScore Float
  beginnerScore      Float
  maintenanceScore   Float
  explanations       Json
  metricsSummary     Json
  isComplete         Boolean    @default(true)
  lastAnalyzedAt     DateTime   @default(now())
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  repository         Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([overallScore])
  @@index([beginnerScore])
  @@index([lastAnalyzedAt])
  @@map("repository_analyses")
}

model Issue {
  id            String     @id @default(uuid()) @db.Uuid
  repositoryId  String     @db.Uuid
  githubIssueId String     @unique
  title         String
  description   String?
  url           String
  state         String
  labels        String[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  repository    Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([state])
  @@map("issues")
}

model DeveloperSkill {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  skillName   String
  proficiency String   @default("Intermediate")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillName])
  @@index([userId])
  @@index([skillName])
  @@index([proficiency])
  @@map("developer_skills")
}

model Recommendation {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @db.Uuid
  repositoryId     String        @db.Uuid
  organizationId   String?       @db.Uuid
  matchScore       Float
  skillCoverage    Float         @default(0)
  proficiencyFit   Float         @default(0)
  repoQualityScore Float?
  matchedSkills    String[]      @default([])
  missingSkills    String[]      @default([])
  explanation      String?
  details          Json?
  isComplete       Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository       Repository    @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([userId, repositoryId])
  @@index([userId])
  @@index([repositoryId])
  @@index([matchScore])
  @@map("recommendations")
}
