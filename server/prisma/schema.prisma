generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String            @id @default(uuid()) @db.Uuid
  githubId             String            @unique
  githubUsername       String            @unique
  email                String?
  avatarUrl            String?
  role                 String            @default("DEVELOPER")
  isAdmin              Boolean           @default(false)
  encryptedAccessToken String?
  tokenIv              String?
  tokenTag             String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  skills          DeveloperSkill[]
  recommendations Recommendation[]
  aiRecommendations AiRecommendation[]

  @@index([role])
  @@map("users")
}

model Organization {
  id          String             @id @default(uuid()) @db.Uuid
  name        String
  slug        String             @unique
  description String?
  website     String?
  githubUrl   String?
  category    String?
  topics      String[]           @default([])
  imageUrl    String?
  sourceUrl   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  years           OrganizationYear[]
  repositories    Repository[]
  recommendations Recommendation[]

  @@index([name])
  @@index([category])
  @@map("organizations")
}

model OrganizationYear {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  year           Int
  projectsUrl    String?
  ideasUrl       String?
  topics         String[]     @default([])
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, year])
  @@index([organizationId])
  @@index([year])
  @@map("organization_years")
}

model Repository {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  githubRepoId   String        @unique
  name           String
  fullName       String        @unique
  description    String?
  language       String?
  stars           Int                 @default(0)
  forks           Int                 @default(0)
  openIssues      Int                 @default(0)
  topics          String[]            @default([])
  extractedSkills String[]            @default([])
  lastUpdatedAt   DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization    Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  issues          Issue[]
  analysis        RepositoryAnalysis?
  recommendations Recommendation[]
  aiRecommendations AiRecommendation[]

  @@index([organizationId])
  @@index([language])
  @@index([stars])
  @@map("repositories")
}

model RepositoryAnalysis {
  id                 String     @id @default(uuid()) @db.Uuid
  repositoryId       String     @unique @db.Uuid
  overallScore       Float
  activityScore      Float
  communityScore     Float
  documentationScore Float
  beginnerScore      Float
  maintenanceScore   Float
  explanations       Json
  metricsSummary     Json
  isComplete         Boolean    @default(true)
  lastAnalyzedAt     DateTime   @default(now())
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  repository         Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([overallScore])
  @@index([beginnerScore])
  @@index([lastAnalyzedAt])
  @@map("repository_analyses")
}

model Issue {
  id                 String     @id @default(uuid()) @db.Uuid
  repositoryId       String     @db.Uuid
  githubIssueId      String     @unique
  number             Int?
  title              String
  description        String?
  url                String
  state              String
  labels             String[]
  isBeginnerFriendly Boolean    @default(false)
  matchingLabels     String[]   @default([])
  assignee           String?
  commentsCount      Int        @default(0)
  closedAt           DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  repository         Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  aiRecommendations  AiRecommendation[]

  @@index([repositoryId])
  @@index([state])
  @@index([isBeginnerFriendly])
  @@index([number])
  @@map("issues")
}

model DeveloperSkill {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  skillName   String
  proficiency String   @default("Intermediate")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillName])
  @@index([userId])
  @@index([skillName])
  @@index([proficiency])
  @@map("developer_skills")
}

model Recommendation {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @db.Uuid
  repositoryId     String        @db.Uuid
  organizationId   String?       @db.Uuid
  matchScore       Float
  skillCoverage    Float         @default(0)
  proficiencyFit   Float         @default(0)
  repoQualityScore Float?
  matchedSkills    String[]      @default([])
  missingSkills    String[]      @default([])
  explanation      String?
  details          Json?
  isComplete       Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository       Repository    @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([userId, repositoryId])
  @@index([userId])
  @@index([repositoryId])
  @@index([matchScore])
  @@map("recommendations")
}

model AiRecommendation {
  id                  String      @id @default(uuid()) @db.Uuid
  userId              String      @db.Uuid
  recommendationType  String      // "REPOSITORY" | "CONTRIBUTION"
  repositoryId        String?     @db.Uuid
  issueId             String?     @db.Uuid
  summary             String
  reasoning           String
  matchedSkills       String[]    @default([])
  missingSkills       String[]    @default([])
  learningCurve       String?
  strengths           String[]    @default([])
  concerns            String[]    @default([])
  checklist           String[]    @default([])
  maintainerQuestions String[]    @default([])
  nextSteps           String[]    @default([])
  sources             Json
  provider            String
  model               String
  isFallback          Boolean     @default(false)
  isComplete          Boolean     @default(true)
  expiresAt           DateTime
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository          Repository? @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  issue               Issue?      @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([recommendationType])
  @@index([repositoryId])
  @@index([issueId])
  @@index([expiresAt])
  @@map("ai_recommendations")
}
